    "AccountCenter.microsoftSkinHelp" : {
      "comment" : "Microsoft Account skin dimension and owned-cape help.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a 64 × 64 or 64 × 32 skin with your Microsoft account. You can choose from capes you already own."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft 账号支持 64 × 64 或 64 × 32 像素的皮肤。披风可从账号已拥有的款式中选择。"
          }
        }
      }
    },
    "AccountCenter.offlineLoginHelp" : {
      "comment" : "Offline Account sign-in form explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline accounts work for local play and on servers that don't require Minecraft account verification."
          }
