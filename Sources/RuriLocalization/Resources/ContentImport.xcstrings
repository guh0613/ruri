    "ContentImport.unavailable" : {
      "comment" : "Instance content drop zone unavailable-state heading.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content Import Is Currently Unavailable"
