{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "ContentImport.copyHint" : {
      "comment" : "Instance content drop zone copy-destination hint.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files will be copied to the current instance"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件将复制到当前实例"
          }
        }
      }
    },
    "ContentImport.dropTitle" : {
      "comment" : "Instance content drag-and-drop import heading. %1$lld: dropped content item count; %2$@: content category title (Mods, Resource Packs, or Shader Packs). Use the singular form for a count of one.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Release to Import %1$lld Item (%2$@)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Release to Import %1$lld Items (%2$@)"
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "松开以导入 %1$lld 项%2$@"
                }
              }
            }
          }
        }
      }
    },
    "ContentImport.emptyHint" : {
      "comment" : "Instance content empty-state import instructions.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag content from Finder, or use “Import…” above."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 Finder 拖入资源，或使用上方的“导入…”。"
          }
        }
      }
    },
    "ContentImport.importing" : {
      "comment" : "Instance content import progress by category. %1$@: content category title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importing %1$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入%1$@"
          }
        }
      }
    },
    "ContentImport.invalidDrop" : {
      "comment" : "Instance content drag-and-drop file-read error.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not read the dropped files. Drag them from Finder again, or use “Import…”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未能读取拖入的文件，请从 Finder 重新拖入，或使用“导入…”。"
          }
        }
      }
    },
    "ContentImport.modFormats" : {
      "comment" : "Mod file import accepted-format hint.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JAR or LITEMOD Files"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JAR 或 LITEMOD 文件"
          }
        }
      }
    },
    "ContentImport.resourcePackFormats" : {
      "comment" : "Resource Pack import accepted-format hint.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
