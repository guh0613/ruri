        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令进程仍然存在。请先在活动监视器中结束该命令，再恢复记录；不会重新执行这条命令。"
          }
        }
      }
    },
    "CoreGameSessionRecovery.matchingProcessIdentity" : {
      "comment" : "Interrupted game session recovery status or explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The process identity still matches. Exit through the game's menu first. Console output may no longer be saved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
