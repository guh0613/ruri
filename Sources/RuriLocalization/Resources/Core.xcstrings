    "GameHost.settingsHelp" : {
      "comment" : "macOS game integration settings and game host launch status. Used for settings help.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use macOS game integration with compatible Java for system Game Mode and instance icons. The system enables Game Mode when its requirements are met; you can disable it in the system Game menu. Custom wrapper commands or incompatible runtimes use standard launching."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用兼容的 Java 时，可启用 macOS 游戏集成，支持游戏模式和实例图标。游戏模式由系统在符合条件时启用，可在系统的游戏菜单中关闭。使用自定义包装命令或运行环境不兼容时，Ruri 会按常规方式启动游戏。"
          }
        }
      }
    },
