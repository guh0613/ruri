    "CoreGameSessionRecovery.gameRunningMonitorDisconnected" : {
      "comment" : "Interrupted game session recovery status or explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game running; monitor disconnected"
          }
        },
        "zh-Hans" : {
