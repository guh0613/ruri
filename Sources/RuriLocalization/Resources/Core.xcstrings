    "CoreGameSessionRecovery.insufficientProcessInformation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The system did not provide enough process information to confirm monitor exit. Refresh shortly. Records that may still be written will remain open."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统没有提供足够的进程信息，当前不能确认监控是否已经退出。请稍后刷新；这时不会收尾仍可能被写入的记录。"
          }
        }
      }
    },
    "CoreGameSessionRecovery.interruptedGameProcessGone" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The monitor was interrupted. Process identity checks confirm the original game process is gone. Actual exit code and time are unavailable."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "监控已中断，核对记录中的身份后确认原游戏进程已消失。没有取得实际退出码或退出时间。"
          }
        }
      }
    },
    "CoreGameSessionRecovery.interruptedUnknownCommandResult" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitor interrupted; command result unknown"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "监控中断，命令结果未知"
          }
        }
      }
    },
