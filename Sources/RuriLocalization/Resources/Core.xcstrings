    "CoreGameSessionRecovery.launchCommandStillExists" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The command process still exists. Stop it in Activity Monitor before recovering the record. The command will not run again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令进程仍然存在。请先在活动监视器中结束该命令，再恢复记录；不会重新执行这条命令。"
          }
        }
      }
    },
    "CoreGameSessionRecovery.matchingProcessIdentity" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The process identity still matches. Exit through the game's menu first. Console output may no longer be saved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进程身份仍然匹配。请先返回游戏，通过游戏菜单退出；这期间控制台输出可能无法继续保存。"
          }
        }
      }
    },
    "CoreGameSessionRecovery.monitorInterruptedAfterExit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The monitor was interrupted while finalizing exit. Recorded exit code and playtime are preserved. The post-exit command will not run again."
          }
        },
        "zh-Hans" : {
