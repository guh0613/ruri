      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The monitor was interrupted and game process identity was unavailable. The record was finalized after user confirmation. Actual exit code and time are unavailable."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "监控已中断且缺少游戏进程身份，由用户确认游戏已退出后收尾。没有取得实际退出码或退出时间。"
          }
        }
      }
    },
    "CoreGameSessionRecovery.launchCommandRunningMonitorDisconnected" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launch command running; monitor disconnected"
