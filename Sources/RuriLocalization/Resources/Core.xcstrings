    "CoreGameSessionRecovery.gameRunningMonitorDisconnected" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game running; monitor disconnected"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏仍在运行，监控已断开"
