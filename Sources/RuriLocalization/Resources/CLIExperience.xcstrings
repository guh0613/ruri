    "CLIExperience.noteConfigValues" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Values are JSON: numbers, true, false and null keep their JSON meaning, and arrays and objects use JSON. Text and choice fields also accept plain text. To store the text \"null\", quote it as '\"null\"'."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "值使用 JSON：数字、true、false 和 null 保持 JSON 含义，数组和对象使用 JSON。文本和选项字段也可直接输入普通文本。要保存文字 \"null\"，请写成 '\"null\"'。"
          }
        }
      }
    },
