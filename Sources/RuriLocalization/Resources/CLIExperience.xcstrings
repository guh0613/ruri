            "state" : "translated",
            "value" : "显示 %1$#@count1@ 项；起始位置 %2$lld。"
          },
          "substitutions" : {
            "count1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
