    "CLIExperience.ambiguousAccountTarget" : {
      "comment" : "CLI target error followed by the matching accounts. %@ is the username or ID prefix the user typed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” matches more than one account; use one of these IDs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”匹配到多个账户，请改用下列 ID 之一。"
          }
        }
      }
    },
    "CLIExperience.ambiguousDirectoryTarget" : {
