    "CLIExperience.page" : {
      "comment" : "Pagination footer in CLI list output. First %lld is the number of items on this page; second %lld is the zero-based result offset.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Showing %1$#@count1@, offset %2$lld."
          },
          "substitutions" : {
            "count1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%lld item"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%lld items"
                    }
                  }
