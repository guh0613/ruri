    "CLIExperience.unknownHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unknown command: %@. Run ruri help --all to list commands."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到命令：%@。使用 ruri help --all 查看命令目录。"
          }
        }
      }
    },
    "CLIExperience.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warning: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
