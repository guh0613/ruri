    "CLIExperience.noteTargets" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Targets accept an exact, case-sensitive name, a short ID of at least 8 characters or a full ID. Use name:<name> or id:<id> when a name looks like an ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
