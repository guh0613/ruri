        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机报告参数或内存上限无效，游戏尚未正常启动。"
          }
        }
      }
    },
    "CoreGameDiagnosis.launchArgumentRejected" : {
      "comment" : "Game diagnosis finding title. Used for launch argument rejected.",
      "extractionState" : "manual",
      "localizations" : {
