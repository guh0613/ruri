            "value" : "Java 启动参数被拒绝"
          }
        }
      }
    },
    "CoreGameDiagnosis.launchArgumentRetry" : {
      "comment" : "Game diagnosis troubleshooting step. Used for launch argument retry.",
      "extractionState" : "manual",
      "localizations" : {
