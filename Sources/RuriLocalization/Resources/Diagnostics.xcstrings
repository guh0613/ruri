    },
    "CoreGameDiagnosis.jvmCrash" : {
      "comment" : "Game diagnosis finding title. Used for jvm crash.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JVM Recorded a Native Crash"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JVM 记录了本机崩溃"
          }
        }
      }
    },
    "CoreGameDiagnosis.jvmCrashCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for jvm crash check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the Java version and versions of mods containing native libraries. Provide the report and reproduction steps to the maintainers."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核对所用 Java 和含本地库的模组版本，将报告与复现步骤一起提供给维护者。"
          }
        }
      }
    },
    "CoreGameDiagnosis.jvmCrashExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for jvm crash explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The virtual machine reports a fatal error. The Problematic frame only identifies the crash location; native libraries, Java, and the system environment must also be considered."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机报告致命错误；Problematic frame 只是崩溃位置，仍需结合本地库、Java 与系统环境判断原因。"
          }
        }
      }
    },
    "CoreGameDiagnosis.jvmCrashReport" : {
      "comment" : "Game diagnosis troubleshooting step. Used for jvm crash report.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preserve the error signal, Problematic frame, and Java version from the JVM report."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留 JVM 报告的错误信号、Problematic frame 与 Java 版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.lastRecordedPhase" : {
      "comment" : "Game diagnosis run facts. Used for last recorded phase. %1$@: last recorded launch stage title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last recorded stage: %1$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最后记录阶段：%1$@"
          }
        }
      }
    },
    "CoreGameDiagnosis.launchArgumentCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for launch argument check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the instance's additional JVM arguments. Keep a copy, then undo recently added arguments one at a time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核对实例的附加 JVM 参数，保留副本后逐项撤销最近增加的参数。"
          }
        }
      }
    },
    "CoreGameDiagnosis.launchArgumentExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for launch argument explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The virtual machine reports invalid arguments or memory limits. The game has not started normally."
          }
