    "CoreGameDiagnosis.loaderModConflict" : {
      "comment" : "Game diagnosis finding title. Used for loader mod conflict.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loader Rejected the Mod Combination"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加载器拒绝了模组组合"
          }
        }
      }
    },
    "CoreGameDiagnosis.loaderModConflictCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for loader mod conflict check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check dependencies against the mod IDs and version ranges in the evidence, and confirm the Minecraft and loader versions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按证据中的模组 ID 和版本范围核对依赖，并确认 Minecraft 与加载器版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.loaderModConflictExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for loader mod conflict explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The loader reports missing dependencies, unmet version requirements, or mod conflicts. The original text usually includes the required version ranges."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加载器报告缺少依赖、版本要求不满足或模组冲突。原文通常包含需要的版本范围。"
          }
        }
      }
    },
    "CoreGameDiagnosis.loaderModConflictRetry" : {
      "comment" : "Game diagnosis troubleshooting step. Used for loader mod conflict retry.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review recent changes in mod management. Change one group of related dependencies at a time, keeping recovery possible, then retry."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在模组管理中处理最近的变更；一次只改一组相关依赖，保留恢复余地后重试。"
          }
        }
      }
    },
    "CoreGameDiagnosis.logExplicitReport" : {
      "comment" : "Game diagnosis troubleshooting step. Used for log explicit report.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explicitly Reported in the Log"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日志明确报告"
          }
        }
      }
    },
    "CoreGameDiagnosis.mainThreadCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for main thread check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the Java and loader versions required by the game, and whether custom arguments affect first-thread launching."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核对游戏所需的 Java 和加载器版本，检查自定义参数是否影响首线程启动。"
          }
        }
      }
    },
    "CoreGameDiagnosis.mainThreadReport" : {
      "comment" : "Game diagnosis troubleshooting step. Used for main thread report.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preserve the Java version, macOS version, and original error text from the report to help determine whether the launcher's launch method needs a fix."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留报告中的 Java、macOS 与错误原文，便于确认是否需要修正启动器的启动方式。"
          }
        }
      }
    },
    "CoreGameDiagnosis.mainThreadViolation" : {
      "comment" : "Game diagnosis finding title. Used for main thread violation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Window Initialization Violated macOS Main-Thread Requirements"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口初始化违反 macOS 主线程要求"
          }
        }
      }
    },
    "CoreGameDiagnosis.mainThreadViolationExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for main thread violation explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocoa or GLFW explicitly reports that windows must be created on the main thread. Check the combination of Java, LWJGL, and first-thread launch arguments."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocoa 或 GLFW 明确报告窗口必须在主线程创建。需要检查 Java、LWJGL 与首线程启动参数的组合。"
          }
        }
      }
    },
