    "CoreGameDiagnosis.mainThreadCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for main thread check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the Java and loader versions required by the game, and whether custom arguments affect first-thread launching."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查游戏要求的 Java 和加载器版本，以及自定义参数是否影响在主线程启动游戏。"
          }
        }
      }
    },
    "CoreGameDiagnosis.mainThreadReport" : {
      "comment" : "Game diagnosis troubleshooting step. Used for main thread report.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the Java version, macOS version, and original error in the report. These help determine whether the launcher needs to change how it starts the game."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向维护者反馈时，请附上 Java 版本、macOS 版本和错误原文，以便检查启动方式。"
          }
        }
      }
    },
    "CoreGameDiagnosis.mainThreadViolation" : {
