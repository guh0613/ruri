    "CoreGameDiagnosis.loaderModConflictCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for loader mod conflict check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the mod IDs and required version ranges in the log against your installed dependencies, Minecraft version, and loader."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看相关日志中的模组 ID 和版本要求，检查所需依赖、Minecraft 版本和加载器版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.loaderModConflictExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for loader mod conflict explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The loader reports missing dependencies, unmet version requirements, or mod conflicts. The original text usually includes the required version ranges."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加载器报告部分模组缺少依赖、版本不符合要求，或彼此冲突。日志通常会列出所需的版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.loaderModConflictRetry" : {
      "comment" : "Game diagnosis troubleshooting step. Used for loader mod conflict retry.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review recent mod changes in Game Content. Change one set of related dependencies at a time, and keep copies so you can undo the changes before trying again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“管理模组”，检查最近的改动。每次只调整一组相关模组及其依赖，保留副本以便恢复，再启动游戏。"
          }
        }
      }
    },
    "CoreGameDiagnosis.logExplicitReport" : {
