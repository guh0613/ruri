    "CoreGameDiagnosis.outOfMemoryCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for out of memory check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Increase the instance's memory allocation only if the Java heap is too small, and leave enough memory for macOS. Also check any recently added mods or high-resolution resources."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果提示 Java heap space，可适当增加实例的内存上限，同时为 macOS 留出可用内存。也请检查最近添加的模组或高分辨率资源包。"
          }
        }
      }
    },
    "CoreGameDiagnosis.outOfMemoryExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for out of memory explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The log contains an OutOfMemoryError. This alone doesn't tell you which memory limit, if any, needs to increase."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日志中出现了 OutOfMemoryError。需要先确认哪一类内存不足，才能判断是否应增加游戏的内存上限。"
          }
        }
      }
    },
    "CoreGameDiagnosis.outOfMemoryTypes" : {
      "comment" : "Game diagnosis troubleshooting step. Used for out of memory types.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First check whether the original text mentions Java heap space, Direct buffer memory, Metaspace, or an inability to create a thread."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看错误后面的说明：Java heap space 表示堆内存不足；Direct buffer memory、Metaspace 和无法创建线程表示其他内存或资源限制。"
          }
        }
      }
    },
    "CoreGameDiagnosis.preparationError" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for preparation error.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The launcher recorded this error while preparing to launch. It doesn't establish that the game crashed."
