    "CoreGameDiagnosis.missingMainClassReport" : {
      "comment" : "Game diagnosis troubleshooting step. Used for missing main class report.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your current configuration files and worlds. If repair doesn't help, include this report when asking for support."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留现有配置和存档。如果修复后仍无法启动，请在反馈时附上诊断报告。"
          }
