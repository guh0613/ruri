{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "CoreGameDiagnosis.actionFailed" : {
      "comment" : "Game diagnosis finding title. Used for action failed. %1$@: launch preparation stage title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Failed"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@失败"
          }
        }
      }
    },
    "CoreGameDiagnosis.analysisReadLimit" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for analysis read limit. %1$@: unread evidence source title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysis reached the 16 MiB read limit. %1$@ was not read."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析读取量已达 16 MiB，未读取 %1$@。"
          }
        }
      }
    },
    "CoreGameDiagnosis.architectureCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for architecture check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check whether the selected Java uses ARM64 or Intel architecture, and choose a version suitable for this game."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核对所选 Java 的 ARM64 / Intel 架构，并使用适用于这套游戏的版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.architectureMismatch" : {
      "comment" : "Game diagnosis finding title. Used for architecture mismatch.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Library or Java Architecture Mismatch"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地库或 Java 的架构不匹配"
          }
        }
      }
    },
    "CoreGameDiagnosis.architectureMismatchExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for architecture mismatch explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The system explicitly reports an incompatible binary architecture. Java and the game's native libraries need matching architectures."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统明确报告二进制架构不兼容，需要让 Java 与游戏本地库使用匹配的架构。"
          }
        }
      }
    },
    "CoreGameDiagnosis.architectureModCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for architecture mod check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check whether mods providing native libraries support the current architecture, then repair the instance to prepare the native libraries again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查提供本地库的模组是否支持当前架构；之后修复实例以重新准备本地库。"
          }
        }
      }
    },
    "CoreGameDiagnosis.boundedTail" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for bounded tail. %1$@: partially analyzed evidence source title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only a limited excerpt of %1$@ was analyzed. Context may be missing; the original file was preserved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 仅分析有界片段，可能缺少上下文；原有文件未修改。"
          }
        }
      }
    },
    "CoreGameDiagnosis.checkAccount" : {
      "comment" : "Game diagnosis panel action button. Used for check account.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check Account"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查账号"
          }
        }
      }
    },
    "CoreGameDiagnosis.checkInstanceSettings" : {
      "comment" : "Game diagnosis panel action button. Used for check instance settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check Instance Settings"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查实例设置"
          }
        }
      }
    },
    "CoreGameDiagnosis.classVersionCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for class version check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check Java in the instance settings and select the version required by the game and modpack."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在实例设置核对 Java，按游戏和整合包要求选择版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.classVersionModCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for class version mod check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you recently replaced a mod, check whether it requires a different Java or Minecraft version."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果刚替换过模组，检查该模组是否要求另一代 Java 或 Minecraft。"
          }
        }
      }
    },
    "CoreGameDiagnosis.classVersionUnreadable" : {
      "comment" : "Game diagnosis finding title. Used for class version unreadable.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java Cannot Read the Required Class Version"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java 无法读取所需的类版本"
          }
        }
      }
    },
    "CoreGameDiagnosis.classVersionUnsupported" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for class version unsupported.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java explicitly reports an unsupported class file version. The game, loader, and mods may each have Java requirements."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java 明确报告类文件版本不受支持。游戏、加载器和模组都可能对 Java 有要求。"
          }
        }
      }
    },
    "CoreGameDiagnosis.cluesNeedingVerification" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for clues needing verification.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clues to Verify"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要验证的线索"
          }
        }
      }
    },
    "CoreGameDiagnosis.collectDiagnosticReports" : {
      "comment" : "Game diagnosis panel action button. Used for collect diagnostic reports.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collect Diagnostic Reports"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收集诊断报告"
          }
        }
      }
    },
    "CoreGameDiagnosis.configBackup" : {
      "comment" : "Game diagnosis troubleshooting step. Used for config backup.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the filename and underlying error in the original text first. Copy the configuration elsewhere as a backup before editing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先查看原文的文件名和底层错误；修改前把该配置复制到别处留作备份。"
          }
        }
      }
    },
    "CoreGameDiagnosis.configReadExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for config read explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The loader reports an unreadable configuration in the error context. This may involve content format, version differences, or file access."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加载器在错误上下文中指出无法读取配置。可能是内容格式、版本差异或文件访问问题。"
          }
        }
      }
    },
    "CoreGameDiagnosis.configReadFailure" : {
      "comment" : "Game diagnosis finding title. Used for config read failure.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed to Read a Configuration File"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置文件读取失败"
          }
        }
      }
    },
    "CoreGameDiagnosis.configRepair" : {
      "comment" : "Game diagnosis troubleshooting step. Used for config repair.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fix the configuration using the mod's instructions. If it needs regeneration, handle only that file to avoid clearing all configurations."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按对应模组说明修正配置；需要重新生成时只处理该文件，避免清空整套配置。"
          }
        }
      }
    },
    "CoreGameDiagnosis.confirmedAbnormalExit" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for confirmed abnormal exit.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game exited abnormally. The cause is currently unknown."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏异常退出，暂时无法确定原因。"
          }
        }
      }
    },
    "CoreGameDiagnosis.debugCrash" : {
      "comment" : "Game diagnosis finding title. Used for debug crash.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Report Identifies a Manually Triggered Debug Crash"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "报告注明手动触发调试崩溃"
          }
        }
      }
    },
    "CoreGameDiagnosis.debugCrashExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for debug crash explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minecraft describes a manual debug crash. This does not establish mod incompatibility."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minecraft 报告的描述是手动调试崩溃，不据此推断模组不兼容。"
          }
        }
      }
    },
    "CoreGameDiagnosis.debugCrashRetry" : {
      "comment" : "Game diagnosis troubleshooting step. Used for debug crash retry.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you triggered this debug action intentionally, save the reports you need and restart normally."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若这是有意触发的调试操作，保存所需报告后正常重新启动。"
          }
        }
      }
    },
    "CoreGameDiagnosis.duplicateMod" : {
      "comment" : "Game diagnosis finding title. Used for duplicate mod.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loader Found Duplicate Mods"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加载器发现重复模组"
          }
        }
      }
    },
    "CoreGameDiagnosis.duplicateModCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for duplicate mod check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the files and versions listed in the original text in mod management."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在模组管理中核对原文列出的文件和版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.duplicateModExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for duplicate mod explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The same mod was loaded multiple times, possibly from different versions or duplicate sources."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一个模组被加载多次，可能存在不同版本或重复来源。"
          }
        }
      }
    },
    "CoreGameDiagnosis.duplicateModRetry" : {
      "comment" : "Game diagnosis troubleshooting step. Used for duplicate mod retry.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disable the extra copy and retry. Do not delete all versions at once."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用多余的一份后重试；不要同时删掉所有版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.evidenceNotRegularFile" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for evidence not regular file.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The evidence is not a regular file."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "证据不是普通文件。"
          }
        }
      }
    },
    "CoreGameDiagnosis.exitCode" : {
      "comment" : "Game diagnosis run facts. Used for exit code.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exit code"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出码"
          }
        }
      }
    },
    "CoreGameDiagnosis.exitSummary" : {
      "comment" : "Game diagnosis run facts. Used for exit summary. %1$@: exit code or termination signal label; %2$@: exit status or signal number formatted as text; %3$@: whether Ruri requested stopping, as localized yes/no.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@; Ruri stop requested: %3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：%2$@；Ruri 结束请求：%3$@"
          }
        }
      }
    },
    "CoreGameDiagnosis.guidanceCheckErrors" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for guidance check errors.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the original errors below and their corresponding settings, then restart after resolving them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核对下方原始错误以及对应设置，处理后重新启动。"
          }
        }
      }
    },
    "CoreGameDiagnosis.guidanceCollectRetry" : {
      "comment" : "Game diagnosis troubleshooting step. Used for guidance collect retry.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it still fails, collect this run's records to compare the errors before and after retrying."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若仍然失败，收集这次运行记录，以便比较重试前后的错误。"
          }
        }
      }
    },
    "CoreGameDiagnosis.hasExitStatus" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for has exit status.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes"
          }
        },
