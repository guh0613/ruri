    "CoreGameDiagnosis.missingMainClassExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for missing main class explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java explicitly reports that it can't load the main class. Check version files, the loader installation, and the launch entry point."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
