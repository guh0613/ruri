    "CoreGameDiagnosticBundle.environment" : {
      "comment" : "Generated diagnostic ZIP report text and selectable report headings. Used for environment. %1$@: Minecraft version; %2$@: loader name; %3$@: loader version, possibly empty; %4$@: Java runtime description; %5$@: memory configuration summary; %6$@: operating system description; %7$@: host CPU architecture; %8$@: account type; %9$@: run creation timestamp; %10$@: last recorded launch stage; %11$@: run state; %12$@: exit kind; %13$@: exit status; %14$@: whether stopping was requested through Ruri; %15$@: normal quit request result.",
