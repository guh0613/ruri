    "CoreGameDiagnosis.mixinApplyExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for mixin apply explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mod couldn't apply a change to the game's code. A mod named in the error or stack trace isn't necessarily the only cause."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模组修改游戏代码时出错。日志中提到的模组可能受到其他模组影响，需要进一步检查。"
          }
        }
      }
    },
    "CoreGameDiagnosis.mixinApplyFailure" : {
      "comment" : "Game diagnosis finding title. Used for mixin apply failure.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixin Failed to Apply"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixin 应用失败"
          }
        }
      }
    },
    "CoreGameDiagnosis.mixinDependencyCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for mixin dependency check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolve any explicit dependency or entry point errors above first, then check the combination of mod versions involved here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果上方还有依赖或模组初始化错误，请先处理这些问题，再检查相关模组的版本是否兼容。"
          }
        }
      }
    },
    "CoreGameDiagnosis.mixinModCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for mixin mod check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Game Content, disable recently changed mods one at a time to test whether they're involved. You can enable them again later. Don't remove multiple mods based on a single warning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“管理模组”，逐个停用最近改动的模组并重试。先停用而不删除，以便恢复；单条警告不足以判断哪些模组需要移除。"
          }
        }
      }
    },
    "CoreGameDiagnosis.modInitializationCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for mod initialization check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the mods, dependencies, and loader versions listed in the evidence."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看相关日志中提到的模组，检查它及其依赖和加载器的版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.modInitializationExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for mod initialization explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The loader reports that an entry point or mod instance failed to initialize. Dependencies or other mods may also be involved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加载器无法完成某个模组的初始化。原因也可能与它依赖的组件或其他模组有关。"
          }
        }
      }
    },
    "CoreGameDiagnosis.modInitializationFailure" : {
      "comment" : "Game diagnosis finding title. Used for mod initialization failure.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod Initialization Failed"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模组初始化失败"
          }
        }
      }
    },
    "CoreGameDiagnosis.modInitializationRetry" : {
      "comment" : "Game diagnosis troubleshooting step. Used for mod initialization retry.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If this started after an update, compare the previous versions. You can also disable recently added mods in Game Content to test whether they're involved, then enable them again later."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果问题出现在更新后，检查之前使用的版本。也可以先停用最近添加的模组并重试，排查后再重新启用。"
          }
        }
      }
    },
    "CoreGameDiagnosis.monitoringInterrupted" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for monitoring interrupted.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitoring stopped before the game's exit status could be recorded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏监控已中断，未记录到退出结果。"
          }
        }
      }
    },
    "CoreGameDiagnosis.nativeMemoryAllocationExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for native memory allocation explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The JVM reports a native memory allocation failure. Increasing the Java heap limit may further reduce memory available to the system."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java 无法分配所需的系统内存。此时增加游戏的内存上限可能让系统可用内存更少。"
          }
        }
      }
    },
    "CoreGameDiagnosis.nativeMemoryAllocationFailure" : {
      "comment" : "Game diagnosis finding title. Used for native memory allocation failure.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java Couldn't Allocate Enough Memory"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机无法分配所需内存"
          }
        }
      }
    },
    "CoreGameDiagnosis.nativeMemoryCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for native memory check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your Mac's memory pressure and other apps' memory use. Make sure the Java heap limit isn't too high."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“活动监视器”中查看内存压力和其他 App 的占用，并检查游戏的内存上限是否设得过高。"
          }
        }
      }
    },
    "CoreGameDiagnosis.nativeMemoryRetry" : {
      "comment" : "Game diagnosis troubleshooting step. Used for native memory retry.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make adjustments, then try launching again. Keep the requested allocation size and failure location from the JVM report for troubleshooting."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整后重新启动游戏，并保留 Java 崩溃报告，以便查看内存分配失败的详情。"
          }
        }
      }
    },
