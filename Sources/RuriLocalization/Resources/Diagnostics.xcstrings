{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "CoreGameDiagnosis.actionFailed" : {
      "comment" : "Game diagnosis finding title. Used for action failed. %1$@: launch preparation stage title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: Failed"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@失败"
          }
        }
      }
    },
    "CoreGameDiagnosis.analysisReadLimit" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for analysis read limit. %1$@: unread evidence source title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysis reached the 16 MiB read limit. %1$@ was not read."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已达到 16 MiB 的分析上限，未读取 %1$@。"
          }
        }
      }
    },
    "CoreGameDiagnosis.architectureCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for architecture check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check whether the selected Java uses ARM64 or Intel architecture, and choose a version suitable for this game."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查所选 Java 使用的是 ARM64 还是 Intel 架构，并选择游戏支持的版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.architectureMismatch" : {
      "comment" : "Game diagnosis finding title. Used for architecture mismatch.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Library or Java Architecture Mismatch"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java 与原生库的架构不兼容"
          }
        }
      }
    },
    "CoreGameDiagnosis.architectureMismatchExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for architecture mismatch explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java and the game's native libraries use incompatible architectures. Choose matching ARM64 or Intel versions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java 与游戏使用的原生库架构不兼容。两者需要使用匹配的 ARM64 或 Intel 版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.architectureModCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for architecture mod check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that mods with native libraries support the selected architecture, then repair the instance to restore the required libraries."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查含原生库的模组是否支持所选架构，再修复实例以重新安装所需的原生库。"
          }
        }
      }
    },
    "CoreGameDiagnosis.boundedTail" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for bounded tail. %1$@: partially analyzed evidence source title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only a limited excerpt of %1$@ was analyzed. Context may be missing; the original file was preserved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅分析了 %1$@ 的部分内容，可能遗漏相关信息。原文件已保留。"
          }
        }
      }
    },
    "CoreGameDiagnosis.checkAccount" : {
      "comment" : "Game diagnosis panel action button. Used for check account.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check Account"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查账号"
          }
        }
      }
    },
    "CoreGameDiagnosis.checkInstanceSettings" : {
      "comment" : "Game diagnosis panel action button. Used for check instance settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check Instance Settings"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查实例设置"
          }
        }
      }
    },
    "CoreGameDiagnosis.classVersionCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for class version check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check Java in the instance settings and select the version required by the game and modpack."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开实例设置，选择游戏或整合包要求的 Java 版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.classVersionModCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for class version mod check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you recently replaced a mod, check whether it requires a different Java or Minecraft version."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果最近更换过模组，请检查它支持的 Java 和 Minecraft 版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.classVersionUnreadable" : {
      "comment" : "Game diagnosis finding title. Used for class version unreadable.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java Can't Read the Required Class Version"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java 版本不兼容"
          }
        }
      }
    },
    "CoreGameDiagnosis.classVersionUnsupported" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for class version unsupported.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java can't read a class file used by the game, loader, or a mod. Check which Java version each one requires."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前 Java 无法读取游戏、加载器或模组中的类文件。请检查它们要求的 Java 版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.cluesNeedingVerification" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for clues needing verification.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Possible Causes to Check"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能的原因，仍需检查"
          }
        }
      }
    },
    "CoreGameDiagnosis.collectDiagnosticReports" : {
      "comment" : "Game diagnosis panel action button. Used for collect diagnostic reports.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collect Diagnostic Reports"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收集诊断报告"
          }
        }
      }
    },
    "CoreGameDiagnosis.configBackup" : {
      "comment" : "Game diagnosis troubleshooting step. Used for config backup.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the filename and underlying error in the log. Back up the configuration file before editing it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看日志中提到的配置文件和具体错误。修改前，先备份该配置文件。"
          }
        }
      }
    },
    "CoreGameDiagnosis.configReadExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for config read explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The loader couldn't read a configuration file. Its format may be invalid, it may belong to another version, or there may be a file access problem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加载器无法读取配置文件。文件格式、配置版本或访问权限可能有问题。"
          }
        }
      }
    },
    "CoreGameDiagnosis.configReadFailure" : {
      "comment" : "Game diagnosis finding title. Used for config read failure.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't Read a Configuration File"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取配置文件"
          }
        }
      }
    },
    "CoreGameDiagnosis.configRepair" : {
      "comment" : "Game diagnosis troubleshooting step. Used for config repair.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow the mod's instructions to fix its configuration. If you need to regenerate a file, replace only that file rather than deleting all configuration files."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按模组说明修正配置。如果需要重新生成配置，只处理出错的文件，保留其他配置。"
          }
        }
      }
    },
    "CoreGameDiagnosis.confirmedAbnormalExit" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for confirmed abnormal exit.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game quit unexpectedly. The cause is unknown."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏异常退出，暂时无法确定原因。"
          }
        }
      }
    },
    "CoreGameDiagnosis.debugCrash" : {
      "comment" : "Game diagnosis finding title. Used for debug crash.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manually Triggered Debug Crash"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动触发的调试崩溃"
          }
        }
      }
    },
    "CoreGameDiagnosis.debugCrashExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for debug crash explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minecraft reports that this crash was triggered manually for debugging. This doesn't indicate a mod conflict."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minecraft 报告这是一次手动触发的调试崩溃，不能据此判断模组是否存在冲突。"
          }
        }
      }
    },
    "CoreGameDiagnosis.debugCrashRetry" : {
      "comment" : "Game diagnosis troubleshooting step. Used for debug crash retry.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you triggered this debug action intentionally, save the reports you need and restart normally."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果这是有意进行的调试操作，保存所需报告后重新启动游戏即可。"
          }
        }
      }
    },
    "CoreGameDiagnosis.duplicateMod" : {
      "comment" : "Game diagnosis finding title. Used for duplicate mod.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loader Found Duplicate Mods"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发现重复模组"
          }
        }
      }
    },
    "CoreGameDiagnosis.duplicateModCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for duplicate mod check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Game Content, check the mod files and versions named in the log."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“管理模组”，查看日志中列出的文件及其版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.duplicateModExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for duplicate mod explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The loader found more than one copy or version of the same mod."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加载器发现同一个模组存在多个副本或版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.duplicateModRetry" : {
      "comment" : "Game diagnosis troubleshooting step. Used for duplicate mod retry.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disable the extra copy and retry. Do not delete all versions at once."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留需要的版本，停用多余的副本，再启动游戏。"
          }
        }
      }
    },
    "CoreGameDiagnosis.evidenceNotRegularFile" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for evidence not regular file.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The evidence is not a regular file."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取此诊断文件：它不是普通文件。"
          }
        }
      }
    },
    "CoreGameDiagnosis.exitCode" : {
      "comment" : "Game diagnosis run facts. Used for exit code.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exit code"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出码"
          }
        }
      }
    },
    "CoreGameDiagnosis.exitSummary" : {
      "comment" : "Game diagnosis run facts. Used for exit summary. %1$@: exit code or termination signal label; %2$@: exit status or signal number formatted as text; %3$@: whether Ruri requested stopping, as localized yes/no.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@; Ruri stop requested: %3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：%2$@；是否通过 Ruri 请求终止：%3$@"
          }
        }
      }
    },
    "CoreGameDiagnosis.guidanceCheckErrors" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for guidance check errors.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the errors and related settings below. Make any needed changes, then try launching again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看相关日志中的具体错误并检查对应设置，再尝试启动游戏。"
          }
        }
      }
    },
    "CoreGameDiagnosis.guidanceCollectRetry" : {
      "comment" : "Game diagnosis troubleshooting step. Used for guidance collect retry.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the problem continues, collect a report for the new session so you can compare the errors."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果仍然失败，收集重试后的运行记录，以便比较两次的错误。"
          }
        }
      }
    },
    "CoreGameDiagnosis.hasExitStatus" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for has exit status.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是"
          }
        }
      }
    },
    "CoreGameDiagnosis.invalidEvidencePathSkipped" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for invalid evidence path skipped.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skipped an invalid evidence path."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已跳过路径无效的诊断文件。"
          }
        }
      }
    },
    "CoreGameDiagnosis.javaNotRecorded" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for java not recorded.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java not recorded"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未记录 Java"
          }
        }
      }
    },
    "CoreGameDiagnosis.jvmCrash" : {
      "comment" : "Game diagnosis finding title. Used for jvm crash.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JVM Recorded a Native Crash"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java 发生严重错误"
          }
        }
      }
    },
    "CoreGameDiagnosis.jvmCrashCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for jvm crash check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the Java version and versions of mods containing native libraries. Provide the report and reproduction steps to the maintainers."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查 Java 和含原生库的模组版本。向维护者反馈时，请附上报告和复现步骤。"
          }
        }
      }
    },
    "CoreGameDiagnosis.jvmCrashExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for jvm crash explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java reported a fatal error. “Problematic frame” shows where it crashed, but doesn't explain why on its own. The native libraries, Java version, and system environment also need to be checked."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java 报告了致命错误。报告中的 Problematic frame 表示崩溃位置，具体原因还需结合原生库、Java 版本和系统环境检查。"
          }
        }
      }
    },
    "CoreGameDiagnosis.jvmCrashReport" : {
      "comment" : "Game diagnosis troubleshooting step. Used for jvm crash report.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preserve the error signal, Problematic frame, and Java version from the JVM report."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留 Java 崩溃报告，其中的错误信号、Problematic frame 和 Java 版本有助于排查问题。"
          }
        }
      }
    },
    "CoreGameDiagnosis.lastRecordedPhase" : {
      "comment" : "Game diagnosis run facts. Used for last recorded phase. %1$@: last recorded launch stage title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last recorded stage: %1$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最后记录的阶段：%1$@"
          }
        }
      }
    },
    "CoreGameDiagnosis.launchArgumentCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for launch argument check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the instance's additional JVM arguments. Save a copy, then remove recently added arguments one at a time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在实例设置中检查附加 JVM 参数。先保存一份副本，再逐项移除最近添加的参数。"
          }
        }
      }
    },
