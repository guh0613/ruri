      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could Not Find or Load Main Class"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到或无法加载主类"
          }
        }
      }
    },
    "CoreGameDiagnosis.missingMainClassCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for missing main class check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the game's and loader's versions in the instance, then use instance repair to restore the installation files."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查实例所用的游戏与加载器版本，再使用实例的修复功能补全安装文件。"
          }
        }
      }
    },
    "CoreGameDiagnosis.missingMainClassCjk" : {
      "comment" : "Game diagnosis finding title. Used for missing main class cjk.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could Not Find or Load Main Class"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到或無法載入主要類別"
          }
        }
      }
    },
    "CoreGameDiagnosis.missingMainClassExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for missing main class explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java explicitly reports that it cannot load the main class. Check version files, the loader installation, and the launch entry point."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java 明确报告无法加载主类。版本文件、加载器安装或启动入口需要检查。"
          }
        }
      }
    },
    "CoreGameDiagnosis.missingMainClassReport" : {
      "comment" : "Game diagnosis troubleshooting step. Used for missing main class report.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preserve existing configurations and worlds. If repair does not resolve the failure, include this report."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留现有配置与存档；若修复后仍失败，附上这次报告。"
          }
        }
      }
    },
    "CoreGameDiagnosis.mixinApplyExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for mixin apply explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This indicates a failure while a mod modifies game code. A mod named in a filename or stack trace cannot be assumed to be the sole cause."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是模组修改游戏代码时的失败线索。文件名或堆栈中的模组不能直接当作唯一责任方。"
          }
        }
      }
    },
    "CoreGameDiagnosis.mixinApplyFailure" : {
      "comment" : "Game diagnosis finding title. Used for mixin apply failure.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error Context Includes a Mixin Application Failure"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "错误上下文中有 Mixin 应用失败"
          }
        }
      }
    },
    "CoreGameDiagnosis.mixinDependencyCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for mixin dependency check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolve any explicit dependency or entry point errors above first, then check the combination of mod versions involved here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先处理上方明确的依赖或入口错误，再检查这里涉及的模组版本组合。"
          }
        }
      }
    },
    "CoreGameDiagnosis.mixinModCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for mixin mod check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verify by gradually disabling recently changed mods in mod management; you can re-enable them later. Do not delete mods in bulk based on a single warning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过模组管理逐步停用最近改动的模组来验证，之后仍能重新启用；不要根据单条警告批量删除模组。"
          }
        }
      }
    },
    "CoreGameDiagnosis.modInitializationCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for mod initialization check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the mods, dependencies, and loader versions listed in the evidence."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核对证据中列出的模组、依赖与加载器版本。"
          }
        }
      }
    },
    "CoreGameDiagnosis.modInitializationExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for mod initialization explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The loader reports that an entry point or mod instance failed to initialize. Dependencies or other mods may also be involved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加载器指出某个入口或模组实例初始化失败；依赖或其他模组仍可能参与其中。"
          }
        }
      }
    },
    "CoreGameDiagnosis.modInitializationFailure" : {
      "comment" : "Game diagnosis finding title. Used for mod initialization failure.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod Initialization Failed"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模组初始化失败"
          }
        }
      }
    },
    "CoreGameDiagnosis.modInitializationRetry" : {
      "comment" : "Game diagnosis troubleshooting step. Used for mod initialization retry.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the error appeared immediately after an update, check the previous version first. You can disable recently added mods in mod management to verify, then re-enable them later."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若错误紧随一次更新出现，先核对此前版本；可在模组管理中停用最近加入的模组来验证，之后仍能重新启用。"
          }
        }
      }
    },
    "CoreGameDiagnosis.monitoringInterrupted" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for monitoring interrupted.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitoring was interrupted. The game's exit result was not obtained."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "监控记录已中断，未取得游戏的退出结果。"
          }
        }
      }
    },
    "CoreGameDiagnosis.nativeMemoryAllocationExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for native memory allocation explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The JVM reports a native memory allocation failure. Increasing the Java heap limit may further reduce memory available to the system."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JVM 报告本机内存分配失败。增大 Java 堆上限可能进一步挤占系统内存。"
          }
        }
      }
    },
    "CoreGameDiagnosis.nativeMemoryAllocationFailure" : {
      "comment" : "Game diagnosis finding title. Used for native memory allocation failure.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtual Machine Cannot Allocate the Required Memory"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机无法分配所需内存"
          }
        }
      }
    },
    "CoreGameDiagnosis.nativeMemoryCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for native memory check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check system memory pressure and memory used by other applications, and whether the Java heap is set too large."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查系统内存压力与其他程序占用，核对是否设置了过大的 Java 堆。"
          }
        }
      }
    },
    "CoreGameDiagnosis.nativeMemoryRetry" : {
      "comment" : "Game diagnosis troubleshooting step. Used for native memory retry.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restart after adjusting. Preserve the allocation size and failure location in the JVM report for troubleshooting."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整后重新启动；保留 JVM 报告中的分配大小和失败位置供排查。"
          }
        }
      }
    },
    "CoreGameDiagnosis.noExitStatus" : {
