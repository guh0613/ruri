    "CoreGameDiagnosis.outOfMemory" : {
      "comment" : "Game diagnosis finding title. Used for out of memory.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java Reported Running Out of Memory"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java 报告内存耗尽"
          }
        }
      }
    },
    "CoreGameDiagnosis.outOfMemoryCheck" : {
      "comment" : "Game diagnosis troubleshooting step. Used for out of memory check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consider adjusting instance memory only for insufficient heap memory, leaving enough for macOS. Also check recently added mods or high-resolution resources."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在堆内存不足时考虑调整实例内存，并给 macOS 留出余量；同时检查最近加入的模组或高分辨率资源。"
          }
        }
      }
    },
    "CoreGameDiagnosis.outOfMemoryExplanation" : {
      "comment" : "Game diagnosis finding explanation. Used for out of memory explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The error context includes OutOfMemoryError. This error type alone does not identify which kind of memory should be increased."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
