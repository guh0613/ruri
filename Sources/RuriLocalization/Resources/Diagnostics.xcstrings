          }
        }
      }
    },
    "CoreGameDiagnosis.javaNotRecorded" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for java not recorded.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Java not recorded"
          }
        },
