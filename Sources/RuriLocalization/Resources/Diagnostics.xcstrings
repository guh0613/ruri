    "CoreGameDiagnosis.launchPreparationFailed" : {
      "comment" : "Game diagnosis summary, evidence limitation, or confidence label. Used for launch preparation failed. %1$@: failed launch preparation stage title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
