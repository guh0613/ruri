<plist version="1.0">
<dict>
	<key>coreGameRunDirectoryCopy.warningText1</key>
	<dict>
		<key>count1</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
		<key>NSStringLocalizedFormatKey</key>
