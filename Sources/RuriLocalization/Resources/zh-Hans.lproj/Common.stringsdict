<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>common.fileCount</key>
	<dict>
		<key>count1</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count1@ 个文件</string>
	</dict>
	<key>common.filesAndSize</key>
	<dict>
		<key>count1</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count1@ 个文件 · %2$@</string>
	</dict>
</dict>
</plist>
