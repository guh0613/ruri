    "CLISetup.onboardingDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage instances, accounts, and settings from the command line, or let an AI agent use Ruri."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过命令行管理实例、账户和配置，也可供 AI agent 调用。"
          }
