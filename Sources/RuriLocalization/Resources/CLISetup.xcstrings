      }
    },
    "CLISetup.onboardingHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installation may require administrator authorization.\nYou can also install later in Settings → Command Line & Automation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装时可能需要管理员授权。\n也可稍后前往「设置 → 命令行与自动化」安装。"
          }
        }
      }
    },
