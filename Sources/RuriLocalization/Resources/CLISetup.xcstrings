{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "CLISetup.authorizationFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not complete system authorization: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未能完成系统授权操作：%@"
          }
        }
      }
    },
    "CLISetup.authorizationHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installing or uninstalling may require administrator authorization."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装或卸载时，系统可能请求管理员授权。"
          }
        }
      }
    },
    "CLISetup.authorizationRequired" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The installation directory requires administrator permission. Open Command line and automation in Ruri settings to authorize installation or removal, or choose an existing writable directory with --bin-dir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装目录需要管理员权限。请打开 Ruri 设置中的“命令行与自动化”，由系统授权完成安装或卸载；也可用 --bin-dir 指定已有的可写命令目录。"
          }
        }
      }
    },
    "CLISetup.authorizeInstall" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruri needs to install the CLI in /usr/local/bin. You can then use ruri in a terminal without configuring PATH."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruri 需要安装命令行工具到 /usr/local/bin。完成后即可在终端使用 ruri，无需手动配置 PATH。"
          }
        }
      }
    },
    "CLISetup.authorizeUninstall" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruri needs to remove the installed CLI link. This does not delete the application or game data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruri 需要移除已安装的命令行链接。这不会删除应用或游戏数据。"
          }
        }
      }
    },
    "CLISetup.copied" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copied"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已复制"
          }
        }
      }
    },
    "CLISetup.copyCommand" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy command"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制命令"
          }
        }
      }
    },
    "CLISetup.copyDirectCommand" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
