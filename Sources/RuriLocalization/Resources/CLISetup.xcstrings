    },
    "CLISetup.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Ruri CLI to manage instances, accounts, and settings, directly or through an AI agent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Ruri CLI 管理实例、账户和配置，也可供 AI agent 调用。"
          }
        }
      }
    },
    "CLISetup.install" : {
      "extractionState" : "manual",
      "localizations" : {
