{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "env": {
            "RURI_BUILD_DIR": "${config:swift.buildPath}"
        }
    },
    "problemMatcher": ["$swiftc"],
    "tasks": [
        {
            "label": "swift: Build All",
            "type": "process",
            "command": "${workspaceFolder}/scripts/swift-build.sh",
            "args": ["-c", "debug", "--build-tests"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Ruri: Build Debug App",
            "type": "process",
            "command": "${workspaceFolder}/scripts/build-app.sh",
            "args": ["debug"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "RURI_BUILD_DIR": "${config:swift.buildPath}",
                    "RURI_APP_PATH": "build/Debug/Ruri.app"
                }
            },
            "group": "build"
        },
        {
            // Ruri starts games through ruri-monitor beside its executable.
            "label": "swift: Build Debug Ruri",
            "type": "process",
            "command": "${workspaceFolder}/scripts/swift-build.sh",
            "args": ["-c", "debug"],
            "group": "build"
        },
        {
            "label": "swift: Build Release Ruri",
            "type": "process",
            "command": "${workspaceFolder}/scripts/swift-build.sh",
            "args": ["-c", "release"],
            "group": "build"
        },
        {
            "label": "swift: Build Debug ruri-cli",
            "type": "process",
            "command": "${workspaceFolder}/scripts/swift-build.sh",
            "args": ["-c", "debug", "--product", "ruri-cli"],
            "group": "build"
        },
        {
            "label": "swift: Build Release ruri-cli",
            "type": "process",
            "command": "${workspaceFolder}/scripts/swift-build.sh",
            "args": ["-c", "release", "--product", "ruri-cli"],
            "group": "build"
        },
        {
            "label": "swift: Build Debug ruri-monitor",
            "type": "process",
            "command": "${workspaceFolder}/scripts/swift-build.sh",
            "args": ["-c", "debug", "--product", "ruri-monitor"],
            "group": "build"
        },
        {
            "label": "swift: Build Release ruri-monitor",
            "type": "process",
            "command": "${workspaceFolder}/scripts/swift-build.sh",
            "args": ["-c", "release", "--product", "ruri-monitor"],
            "group": "build"
        }
    ]
}
